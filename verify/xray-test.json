{
  "_comment": "仅用于 CI 校验：用真实 Xray 加载 ext: 引用的自建 dat（名字已与官方 dat 区分，避免遮蔽）。domain 与 ip 必须拆成两条规则：同一条规则里两者是 AND（实测）。",
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": { "auth": "noauth" }
    }
  ],
  "outbounds": [
    { "tag": "direct", "protocol": "freedom" },
    { "tag": "proxy", "protocol": "freedom" },
    { "tag": "blocked", "protocol": "blackhole" }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "outboundTag": "blocked",
        "domain": ["ext:self-geosite.dat:advert.com"]
      },
      {
        "type": "field",
        "outboundTag": "blocked",
        "domain": ["ext:self-geosite.dat:advert.cn"]
      },
      {
        "type": "field",
        "outboundTag": "proxy",
        "domain": ["ext:self-geosite.dat:self-proxy"]
      },
      {
        "type": "field",
        "outboundTag": "direct",
        "domain": [
          "ext:self-geosite.dat:site.cn",
          "ext:self-geosite.dat:self-direct"
        ]
      },
      {
        "type": "field",
        "outboundTag": "direct",
        "ip": [
          "ext:self-geoip.dat:self-direct",
          "geoip:private"
        ]
      },
      {
        "type": "field",
        "outboundTag": "proxy",
        "network": "tcp,udp"
      }
    ]
  }
}
