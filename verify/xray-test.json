{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": { "auth": "noauth" }
    }
  ],
  "outbounds": [
    { "tag": "direct", "protocol": "freedom" },
    { "tag": "proxy", "protocol": "freedom" },
    { "tag": "blocked", "protocol": "blackhole" }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "outboundTag": "blocked",
        "domain": ["ext:self-geosite.dat:self-reject"]
      },
      {
        "type": "field",
        "outboundTag": "proxy",
        "domain": ["ext:self-geosite.dat:self-proxy"]
      },
      {
        "type": "field",
        "outboundTag": "direct",
        "domain": [
          "ext:self-geosite.dat:china-direct",
          "ext:self-geosite.dat:self-direct"
        ],
        "ip": [
          "ext:self-geoip.dat:self-direct",
          "geoip:private"
        ]
      },
      {
        "type": "field",
        "outboundTag": "proxy",
        "network": "tcp,udp"
      }
    ]
  }
}
